# Strapi - Configuration locale
# Copier ce fichier en .env et renseigner les valeurs.
# Ne jamais commiter le fichier .env.

# Serveur
HOST=0.0.0.0
PORT=1337

# Cles de securite - generer avec : openssl rand -base64 32
APP_KEYS=key1-to-change,key2-to-change
API_TOKEN_SALT=salt-to-change
ADMIN_JWT_SECRET=secret-to-change
TRANSFER_TOKEN_SALT=salt-to-change

# Base de donnees (SQLite local - le fichier data/strapi.db est ignore par Git)
# Pas de variable a renseigner, le chemin est defini dans config/database.ts

# Desactiver le programme d'amelioration Strapi (NPS) en dev
STRAPI_DISABLE_NPS=true

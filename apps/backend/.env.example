# Source des donnees CMS : "airtable" (defaut) ou "strapi"
CMS_SOURCE=airtable

# Airtable API Configuration
AIRTABLE_API_KEY=your_airtable_pat_here

# Preferred project table variables
AIRTABLE_PROJECTS_BASE_ID=your_projects_base_id_here
AIRTABLE_PROJECTS_TABLE_ID=your_projects_table_id_here

# Legacy fallbacks still supported locally
AIRTABLE_BASE_ID=your_base_id_here
AIRTABLE_TABLE_ID=your_table_id_here

# Strapi API Configuration (utilisee uniquement si CMS_SOURCE=strapi)
# Token lecture seule uniquement. Ne pas utiliser de token d'ecriture cote frontend.
STRAPI_API_URL=http://localhost:1337
STRAPI_API_TOKEN=your_strapi_read_only_token_here

# Server
PORT=3000

# Strapi API Configuration
# Token lecture seule uniquement. Ne pas utiliser de token d'ecriture cote frontend.
STRAPI_API_URL=http://localhost:1337
STRAPI_API_TOKEN=your_strapi_read_only_token_here

# Secret partagé uniquement entre Strapi et le backend pour invalider le cache
# après une création, édition, publication ou dépublication.
PROJECT_CACHE_INVALIDATION_SECRET=generate_a_long_random_secret

# Server
PORT=3000
